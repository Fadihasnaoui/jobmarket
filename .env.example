# PostgreSQL (matches docker-compose defaults)
DATABASE_URL=postgresql+asyncpg://jobmarket:jobmarket@localhost:5432/jobmarket

# Alembic uses a sync driver
DATABASE_URL_SYNC=postgresql+psycopg://jobmarket:jobmarket@localhost:5432/jobmarket

# Adzuna API (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble API (https://jooble.org/api/about)
JOOBLE_API_KEY=

# LLM extraction (Stage B skill extraction). Provider-agnostic via env: swapping
# to OpenAI, Anthropic, or another OpenAI-compatible host is a config change only.
# Currently: Groq (OpenAI-compatible API) — https://console.groq.com/docs/api-reference
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=

# Semantic embeddings (Phase C)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_NORMALIZE=true
EMBEDDING_MODEL_REVISION=
